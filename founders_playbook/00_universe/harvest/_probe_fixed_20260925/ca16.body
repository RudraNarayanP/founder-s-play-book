                        <li class="item">
                            <figure>
                                <div class="iconic-container">
                                    <a
                                        href="https://www.loc.gov/apis/micro-services/image-services/"
                                    >
                                        <img
                                            class="iconic"
                                            src="https://labs.loc.gov/static/labs/data/images/apis/iiif.png"
                                            alt="A logo with four stylized blue and red letters, iiif"
                                        />
                                    </a>
                                </div>
                            </figure>
                            <div class="description">
                                <div class="item-description">
                                    <span class="item-description-title">
                                        <a
                                            href="https://www.loc.gov/apis/micro-services/image-services/"
                                        >
                                            Image Services API
                                        </a>
                                    </span>
                                    <span class="item-description-abstract">
                                        The Library of Congress Image Services API specifies a web
                                        service that returns an image, or informaion about an image,
                                        in response to a standard HTTPS request. The request can
                                        specify the region, size, rotation, quality characteristics
                                        and format of the returned image or request basic technical
                                        information about an image. The API is implemented using the
                                        International Image Interoperability Framework (IIIF) Image
                                        API.
                                    </span>
                                    <table class="table-bordered table-padded table-full-width">
                                        <tr>
                                            <th scope="row">Official documentation</th>
                                            <td>
                                                <a
                                                    href="https://www.loc.gov/apis/micro-services/image-services/"
                                                >
                                                    https://www.loc.gov/apis/micro-services/image-services/
                                                </a>
                                            </td>
                                        </tr>

                                        <tr>
                                            <th scope="row">Resources</th>
                                            <td>
                                                <p>
