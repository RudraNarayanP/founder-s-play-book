                    alt="Labs"></a>
            </div>
            <div class="header-labs-menu">
                <button class="header-menu-button"
                    id="header-menu-button"
                    aria-controls="header-menu-container"><span>menu </span><i
                    class="icon icon-bars"></i></button>
                
                <div class="articles-menu-labs page-menu-labs">
                    <nav aria-label="Menu">
                        <ul>
                            
                            
