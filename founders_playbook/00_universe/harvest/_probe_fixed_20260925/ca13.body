<script>
// header toggle menu
$(document).ready(function(){
    function cloneNav() {
        $('.page-menu-labs')
            .clone()
            .appendTo('.header-labs-menu')
            .removeClass('articles-menu-labs page-menu-labs')
            .addClass('page-menu-labs-clone')
            .attr({
                'aria-labelledby': 'header-menu-button',
                id: 'header-menu-container'
            });
    }
    function closeNav() {
        $('.page-menu-labs-clone')
            .slideUp()
            .attr('aria-hidden', 'true');
        $('.header-menu-button')
            .html('<span>open nav </span><i class="icon icon-bars"></i>')
            .attr('aria-expanded', 'false');
    }
    function openNav() {
        $('.page-menu-labs-clone')
            .slideDown()
            .attr('aria-hidden', 'false');
        $('.header-menu-button')
            .html('<span>close nav </span><i class="icon icon-times"></i>')
            .attr('aria-expanded', 'true');
    }
    cloneNav();
    closeNav();
    $('.header-menu-button').on('click', function() {
        if ($('.page-menu-labs-clone').is(':hidden')) {
            openNav();
        } else {
            closeNav();
        }
    });
    $('html').on('click touchstart keydown keyup', function(event) {
        closeNav();
    });
    $('.header-menu-button, .page-menu-labs-clone').on('click touchstart keydown keyup', function(event) {
        event.stopPropagation();
        // allow escape key to close for accessibility
        if (event.which == 27) {
            closeNav();
        }
    });
    // close if window is resized
    $(window).on('resize', function(){
        closeNav();
    });

});
</script>





    





