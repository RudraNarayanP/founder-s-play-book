  color: #242424;
}
.header-labs .page-menu-labs > nav > ul > li:first-child {
  display: none;
}
@media (max-width: 992px) {
  .header-labs .page-menu-labs {
    display: none;
  }
  .header-labs .page-menu-labs.active {
    display: block;
  }
}
</style>


